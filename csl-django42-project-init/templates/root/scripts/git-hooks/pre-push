#!/bin/sh
# Pre-push hook: 只检查本次待推送提交中的 Git 内容。
# Git whitespace 规则由 .gitattributes 定义，Markdown 双空格换行不视为错误。

set -eu

zero_oid=0000000000000000000000000000000000000000
checked=0

while read -r local_ref local_oid remote_ref remote_oid; do
    # 删除远程分支时没有本地提交需要检查。
    [ "$local_oid" = "$zero_oid" ] && continue

    if [ "$remote_oid" = "$zero_oid" ]; then
        commits=$(git rev-list "$local_oid" --not --remotes)
    else
        commits=$(git rev-list "$remote_oid..$local_oid")
    fi

    for commit in $commits; do
        git diff-tree --check --root -r --no-commit-id "$commit"
        checked=$((checked + 1))
    done
done

echo "pre-push：已检查 $checked 个待推送提交（未运行 Django、数据库或 pytest）。"
