root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 110

[*.{js,ts,jsx,tsx,json,yml,yaml,css,scss,html}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.py]
# Black: line-length=110, skip-string-normalization, 4-space indent
indent_size = 4
max_line_length = 110
